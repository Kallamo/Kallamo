{
  "name": "kallamo",
  "version": "2.0.0-beta.1",
  "description": "A local-first studio for roleplay and long-form writing.",
  "desktopName": "Kallamo",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "build:narrative": "tsc -p tsconfig.narrative-runtime.json",
    "build": "npm run build:narrative && vite build",
    "typecheck": "tsc --noEmit",
    "setup:sqlite": "node tools/setup-sqlite-bindings.cjs",
    "postinstall": "node tools/setup-sqlite-bindings.cjs",
    "pretest": "npm run build:narrative && node tools/setup-sqlite-bindings.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:narrative": "vitest run tests/narrative",
    "start": "npm run build && electron .",
    "electron:dev": "npm run build:narrative && concurrently -k \"npm run dev\" \"electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.kallamo.app",
    "productName": "Kallamo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "src/**/*",
      "package.json",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/onnxruntime-node/**/*",
      "!node_modules/gpt-tokenizer/dist/**/*",
      "!node_modules/gpt-tokenizer/esm/**/*",
      "!node_modules/gpt-tokenizer/src/**/*",
      "!node_modules/gpt-tokenizer/data/cl100k_base.tiktoken",
      "!node_modules/gpt-tokenizer/data/p50k_base.tiktoken",
      "!node_modules/gpt-tokenizer/data/r50k_base.tiktoken"
    ],
    "fileAssociations": [
      {
        "ext": "klp",
        "name": "Kallamo AI Profile",
        "description": "Kallamo Portable AI Profile Package"
      },
      {
        "ext": "klw",
        "name": "Kallamo Workflow",
        "description": "Kallamo Portable Multi-Step Workflow Package"
      },
      {
        "ext": "klkb",
        "name": "Kallamo Knowledge Base",
        "description": "Kallamo Portable Knowledge Base Package"
      },
      {
        "ext": "klwb",
        "name": "Kallamo Worldbuild",
        "description": "Kallamo Portable Worldbuild Package"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kallamo",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/icon.png",
      "category": "Office",
      "maintainer": "Jonathan Ferreira da Conceição <jonathanfcon@gmail.com>",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kallamo",
        "repo": "Kallamo"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ]
  },
  "keywords": [],
  "author": "Jonathan Ferreira da Conceição <jonathanfcon@gmail.com>",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/merriweather": "^5.2.6",
    "@huggingface/transformers": "^4.2.0",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-font-family": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-typography": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tiptap-markdown": "^0.9.0",
    "undici": "^6.27.0",
    "unpdf": "^1.6.2"
  }
}
